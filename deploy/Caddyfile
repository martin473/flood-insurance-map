# SITE_ADDRESS in deploy/.env: ":80" serves plain HTTP on the droplet's IP address.
# Set it to a domain name pointed at the droplet (e.g. flood.sawyersweet.net) and Caddy gets an HTTPS certificate automatically.
{$SITE_ADDRESS::80} {
	encode gzip

	# /api/property reaches the app as /property
	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/map
		try_files {path} /rhode-island-flood-map.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
